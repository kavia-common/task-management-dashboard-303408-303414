# Backend environment variables (example; do not put secrets in git)
#
# Preferred DB connection string:
# - DATABASE_URL (preferred) with SQLAlchemy URL format
# - DB_URL (fallback) if your environment provides that instead
#
# Example for the local PostgreSQL container (see task_management_database/db_connection.txt):
DATABASE_URL=postgresql+psycopg2://appuser:dbuser123@localhost:5000/myapp

# Optional tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
